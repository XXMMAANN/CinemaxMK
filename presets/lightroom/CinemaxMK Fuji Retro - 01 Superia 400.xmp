    <rdf:Alt>
     <rdf:li xml:lang="x-default">CinemaxMK Fuji Retro</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm consumer colour-negative look inspired by Fujicolor Superia 400: green-cyan shadows, yellow-warm highlights, cyan-leaning skies, punchy reds, a lifted film base and 400-speed grain.</rdf:li>
    </rdf:Alt>
   </crs:Description>
