    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Airy pastel look inspired by Fujicolor Pro 400H: lifted mint-green shadows, soft cyan skies, pale peachy skin, low contrast and gentle grain. Likes a little extra exposure.</rdf:li>
    </rdf:Alt>
   </crs:Description>
