   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">05 Classic Neg</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">05 Classic Neg</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">05 Classic Neg</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CinemaxMK Fuji Retro</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Hard, contrasty look inspired by the Classic Neg film simulation: cyan-green shadows, warm highlights, reds pulled toward magenta, muted olive greens and dark desaturated blues, like a scanned drugstore print.</rdf:li>
    </rdf:Alt>
   </crs:Description>
