    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Muted documentary look inspired by the Classic Chrome film simulation: desaturated steel-cyan blues, deeper reds, hard shadows with soft highlights and a magazine-print feel.</rdf:li>
    </rdf:Alt>
   </crs:Description>
