   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">04 Nostalgic Neg</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">04 Nostalgic Neg</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">04 Nostalgic Neg</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CinemaxMK Fuji Retro</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">1970s 'American New Color' look inspired by the Nostalgic Neg film simulation: amber highlights, warm rich midtones, soft contrast, quiet greens and blues, and a light fade.</rdf:li>
    </rdf:Alt>
   </crs:Description>
